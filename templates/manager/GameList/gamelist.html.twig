{% set isArchivedView = app.request.attributes.get('sessionState', 'public') == 'archived' %}
{% macro renderConnectionsPopover(allRows, rowsByDbName = {}, sessionDbName = null, emptyLabel = 'No connections') %}
    {% set rows = sessionDbName is null
        ? allRows|default([])
        : rowsByDbName[sessionDbName]|default([])
    %}
    {% if rows is empty %}
        <em>{{ emptyLabel }}</em>
    {% else %}
        <ul class="mb-0 ps-3">
            {% for row in rows %}
                <li>
                    <strong>{{ row.process }}</strong>
                    {% if row.duration|default(0) > 0 %}
                        <span class="text-muted">({{ row.duration }}s)</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}
{% import _self as popovers %}
{% set sessionConnectionsPopoverHtml = popovers.renderConnectionsPopover(
    sessionConnections|default([]),
    sessionConnectionsByDbName|default({}),
    null,
    'No session connections'
) %}
{% set otherConnectionsPopoverHtml = popovers.renderConnectionsPopover(
    otherConnections|default([]),
    {},
    null,
    'No other connections'
) %}
<turbo-frame id="sessionsTable">
    <table class="table table-hover table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Session Name</th>
            <th>Configuration</th>
            <th style="width: 100px;">State</th>
            <th>Current Month</th>
            <th>Ending Month</th>
            <th class="text-center text-nowrap" style="width: 160px;">Quick Actions</th>
            <th class="text-start text-nowrap" style="width: 1%;">
                <span class="{% if isArchivedView %}invisible{% endif %}">
                    <span data-bs-toggle="tooltip" data-bs-title="Total players (past hour)">
                        <i class="fa fa-user"></i>
                        {{ totalPlayersPastHour|default(0) }}
                    </span>
                    <span class="mx-1">|</span>
                    <span
                        class="connection-popover-trigger"
                        tabindex="0"
                        data-bs-custom-class="connections-popover"
                        data-popover-title="Session connections"
                        data-popover-content="{{ sessionConnectionsPopoverHtml|e('html_attr') }}"
                    >
                        <i class="fa fa-database"></i>
                        {{ totalSessionConnections|default(0) }}
                    </span> +
                </span>
                <span
                    class="connection-popover-trigger"
                    tabindex="0"
                    data-bs-custom-class="connections-popover"
                    data-popover-title="Other connections"
                    data-popover-content="{{ otherConnectionsPopoverHtml|e('html_attr') }}"
                >{% if isArchivedView %}<i class="fa fa-database"></i>{% endif %} {{ otherConnections|length|default(0) }}</span>
            </th>
        </tr>
        </thead>
        <tbody>
        {% if sessionslist is empty %}
            <tr>
                <td colspan="8">No sessions (of this type) yet.</td>
            </tr>
        {% endif %}
        {% for game in sessionslist %}
            {% set sessionConnectionsForGamePopoverHtml = popovers.renderConnectionsPopover(
                sessionConnections|default([]),
                sessionConnectionsByDbName|default({}),
                game.session_db_name|default(null),
                'No session connections'
            ) %}
            <tr>
                <td>{{ game.id }}</td>
                <td>{{ game.name }}</td>
                <td>{{ game.config_file_name }}</td>
                {% if game.session_state != 'healthy' %}
                    {% set state = game.session_state %}
                {% else %}
                    {% set state = game.game_state.value|lower %}
                    {% set transitionState = game.game_transition_state %}
                {% endif %}
                <td class="state_{{ state }}">
                    {% if transitionState is defined and transitionState is not null %}
                        {% if transitionState.value|lower != state %}
                            {{ transitionState.value|lower }}
                        {% endif %}
                        <i class="fa fa-solid fa-arrow-right"></i>
                    {% endif %}
                    {{ state }}
                    {% if (state == 'request') %}
                        <i class="fa fa-spinner fa-pulse" data-bs-toggle="tooltip" data-bs-title="Your session is being created..."></i>
                    {% elseif (game.game_transition_state is not null) %}
                        <i class="fa fa-spinner fa-pulse" data-bs-toggle="tooltip" data-bs-title="Running simulations..."></i>
                    {% endif %}
                </td>
                <td>
                    {% if game.game_transition_month is not null %}
                        {% if game.game_transition_month != game.game_current_month %}
                            {{ game.transition_month_formatted }}
                        {% endif %}
                        <i class="fa fa-solid fa-arrow-right"></i>
                    {% endif %}
                    {{ game.current_month_formatted }}
                    {% if (game.game_transition_month is not null) %}
                        <i class="fa fa-spinner fa-pulse" data-bs-toggle="tooltip" data-bs-title="Running simulations..."></i>
                    {% endif %}
                </td>
                <td>{{ game.end_month_formatted }}</td>
                <td class="text-center text-nowrap" style="width: 160px;">
                    <div class="d-inline-flex flex-nowrap gap-1">
                    {% if showGameButton('pause', game) %}
                        <button class="btn btn-secondary btn-sm"
                            data-session="{{ game.id }}"
                            data-state="pause"
                            data-action="gamelist#sessionState"
                            data-bs-toggle="tooltip"
                            data-bs-title="Pause">
                            <i class="fa fa-pause"></i>
                        </button>
                    {% elseif showGameButton('play', game) %}
                        <button class="btn btn-secondary btn-sm"
                            data-session="{{ game.id }}"
                            data-state="play"
                            data-action="gamelist#sessionState"
                            data-bs-toggle="tooltip"
                            data-bs-title="Play">
                            <i class="fa fa-play"></i>
                        </button>
                    {% else %}
                        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="State change impossible at this time">
                            <button class="btn btn-secondary btn-sm" disabled style="pointer-events: none;">
                                <i class="fa fa-pause"></i>
                            </button>
                        </span>
                    {% endif %}
                    {% if showGameButton('save', game) %}
                        <button class="btn btn-secondary btn-sm"
                            data-session="{{ game.id }}"
                            data-type="full"
                            data-action="gamelist#sessionSave"
                            data-bs-toggle="tooltip"
                            data-bs-title="Save">
                            <i class="fa fa-save"></i>
                        </button>
                    {% else %}
                        <span class="d-inline-block" data-bs-toggle="tooltip" data-bs-title="Pause before you can save">
                            <button class="btn btn-secondary btn-sm" disabled style="pointer-events: none;">
                                <i class="fa fa-save"></i>
                            </button>
                        </span>
                    {% endif %}
                        <button class="btn btn-secondary btn-sm"
                            data-session="{{ game.id }}"
                            data-action="modal-game#openSessionDetailsModal"
                            data-bs-toggle="tooltip"
                            data-bs-title="Session details">
                            <i class="fa fa-info-circle"></i>
                        </button>
                    </div>
                </td>
                <td class="text-start">
                    <span class="{% if isArchivedView %}invisible{% endif %}">
                        <span data-bs-toggle="tooltip" data-bs-title="Players in this session (past hour)">
                            <i class="fa fa-user"></i>
                            {{ game.players_past_hour|default(0) }}
                        </span>
                        <span class="mx-1">|</span>
                        <span
                            class="connection-popover-trigger"
                            tabindex="0"
                            data-bs-custom-class="connections-popover"
                            data-popover-title="Connections in this session"
                            data-popover-content="{{ sessionConnectionsForGamePopoverHtml|e('html_attr') }}"
                        >
                            <i class="fa fa-database"></i>
                            {{ game.session_connection_count|default(0) }}
                        </span>
                    </span>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>
