<turbo-frame id="databaseConnectionsTable">
    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>DB</th>
            <th>Process name</th>
            <th>Duration (s)</th>
        </tr>
        </thead>
        <tbody>
        {% if rows is empty %}
            <tr>
                <td colspan="3">No database connections found.</td>
            </tr>
        {% endif %}
        {% for row in rows %}
            <tr>
                <td>{{ row.db|default('') }}</td>
                <td>{{ row.process|default('') }}</td>
                <td>{{ row.duration|default(0) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>

