{% extends 'base.html.twig' %}

{% block subtitle %}Database{% endblock %}

{% block body %}
<div class="py-2">
    <h4 class="mb-3">Database connections</h4>

    <form
        class="row g-2 align-items-end mb-3"
        method="get"
        action="{{ path('manager_database_table') }}"
        data-turbo-frame="databaseConnectionsTable"
    >
        <div class="col-sm-6 col-md-4">
            <label class="form-label" for="sessionFilter">Session filter</label>
            <select id="sessionFilter" name="sessionId" class="form-select">
                <option value="0" {% if selectedSessionId|default(0) == 0 %}selected{% endif %}>All sessions</option>
                {% for session in sessions %}
                    <option value="{{ session.id }}" {% if selectedSessionId|default(0) == session.id %}selected{% endif %}>
                        #{{ session.id }} - {{ session.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Apply</button>
        </div>
    </form>

    <turbo-frame
        id="databaseConnectionsTable"
        src="{{ path('manager_database_table', {'sessionId': selectedSessionId|default(0)}) }}"
        data-turbo-refresh-interval="5000"
    >
        <div class="text-muted">Loading database connections...</div>
    </turbo-frame>
</div>
{% endblock %}

