{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-imagick": "You only require imagick for image processing, e.g. for POV config creation."
    },
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "api-platform/doctrine-orm": "^4.3.18",
        "api-platform/symfony": "^4.3.18",
        "blackfire/php-sdk": "^3.0.1",
        "cboden/ratchet": "dev-master",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.0",
        "drift/dbal": "dev-master",
        "dunglas/doctrine-json-odm": "^1.5",
        "gasparesganga/php-shapefile": "^3.4.1",
        "illuminate/collections": "^13.31",
        "justinrainbow/json-schema": "^6.12",
        "knplabs/knp-menu-bundle": ">=3.7",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/api-doc-bundle": "^5.12.1",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.5",
        "predis/predis": ">=3.6.0",
        "react/mysql": "^0.6.0",
        "shivas/versioning-bundle": "^4.2",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "swaggest/json-schema": "^0.12.43",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^3.0|^4.0.2",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-turbo": "^3.4",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webpack-encore-bundle": ">=2.4.1",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^2.12|^3.24",
        "twig/twig": "^2.12|^3.28.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "src/",
                "src-symfony8.x/"
            ],
            "App\\Domain\\API\\": "api",
            "DoctrineMigrations\\GameSession\\": "migrations/game_session/",
            "DoctrineMigrations\\ServerManager\\": "migrations/server_manager/",
            "ServerManager\\": "ServerManager/classes/",
            "App\\Tests\\": "tests/",
            "App\\DataFixtures\\": "fixtures/"
        },
        "files": [
            "src/helpers.php",
            "src/functions.php",
            "src/Domain/WsServer/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
	        "App\\DataFixtures\\": "fixtures/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "App\\Composer\\ScriptHandler::clearDoctrineMetadataCache",
            "@auto-scripts",
            "bash tools/cghooks-fresh-install.sh"
        ],
        "post-update-cmd": [
            "App\\Composer\\ScriptHandler::clearDoctrineMetadataCache",
            "@auto-scripts",
            "bash tools/cghooks-fresh-install.sh"
        ],
        "cghooks": "vendor/bin/cghooks"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "hooks": {
            "config": {
                "stop-on-failure": ["pre-push"]
            },
            "post-merge": [
                "bash install.sh"
            ],
            "pre-push": [
                "bash test.sh",
                "vendor/bin/phpstan analyse --memory-limit=1G"
            ]
        },
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        },
        "symfony/flex": {
            "synchronize_package_json": false
        }
    },
    "require-dev": {
        "brainmaestro/composer-git-hooks": "dev-master",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.3.3",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BredaUniversityResearch/composer-git-hooks.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/BredaUniversityResearch/Ratchet.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/BredaUniversityResearch/reactphp-dbal.git"
        }
    ]
}
