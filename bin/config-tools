#!/usr/bin/env php
<?php

// The config tools without the server: php bin/config-tools list
// (the commands are the config commands of the server, see docs/config-tools-cli.md)

// the code uses PHP 8.4: say so before PHP stumbles over its syntax
if (PHP_VERSION_ID < 80400) {
    fwrite(STDERR, 'config-tools needs PHP 8.4 or later, this is PHP ' . PHP_VERSION . ".\n");
    exit(1);
}

// a PHP without a php.ini (such as the one inside the executable) allows 128 MB, and a large config is read, merged and
// compared as a whole: make room, for the one process of this tool (CONFIG_TOOLS_MEMORY_LIMIT changes it)
ini_set('memory_limit', getenv('CONFIG_TOOLS_MEMORY_LIMIT') ?: '1G');

// the autoloader of the project, or of the project that has this one as a dependency
$autoloader = null;
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if (is_file($candidate)) {
        $autoloader = $candidate;
        break;
    }
}
if ($autoloader === null) {
    fwrite(STDERR, "The autoloader was not found: run composer install first.\n");
    exit(1);
}
require $autoloader;

exit((new App\ConfigTools\ConfigToolsApplication())->run());
