{
    "name": "msp-challenge/config-tools",
    "description": "The config tools of the MSP Challenge server (split, strip, merge, verify, validate and list configs), without the server. Used to build config-tools.phar: see docs/building-config-tools.md",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "justinrainbow/json-schema": "^6.12",
        "psr/cache": "^3.0",
        "symfony/console": "^7.4.18 || ^8.1",
        "symfony/filesystem": "^7.4.18 || ^8.1",
        "symfony/finder": "^7.4.17 || ^8.1",
        "symfony/process": "^7.4.18 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
