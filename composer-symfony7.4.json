{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-imagick": "You only require imagick for image processing, e.g. for POV config creation."
    },
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "api-platform/doctrine-orm": "^4.3.14",
        "api-platform/symfony": "^4.3.14",
        "blackfire/php-sdk": "^2.6",
        "cboden/ratchet": "dev-master",
        "clue/http-proxy-react": "^1.9",
        "doctrine/annotations": "^2.0.2",
        "doctrine/dbal": "^3.10.5",
        "doctrine/doctrine-bundle": "^2.18.3",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.7",
        "drift/dbal": "dev-master",
        "dunglas/doctrine-json-odm": "^1.5",
        "gasparesganga/php-shapefile": "^3.4.1",
        "illuminate/collections": "^11.51",
        "jfcherng/php-diff": "^6.16.2",
        "justinrainbow/json-schema": "^6.10",
        "knplabs/knp-menu-bundle": "^3.7",
        "lcobucci/jwt": "^5.6",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/api-doc-bundle": "^5.10.3",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.2",
        "phpunit/phpunit": "^9.6.34",
        "predis/predis": "^2.4.1",
        "react/http": "^1.11",
        "react/mysql": "^0.6.0",
        "react/promise": "^3.3",
        "shivas/versioning-bundle": "^4.2",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "swaggest/json-schema": "^0.12.43",
        "symfony/asset": ">=7.4.8",
        "symfony/asset-mapper": ">=7.4.13",
        "symfony/browser-kit": ">=7.4.8",
        "symfony/console": ">=7.4.13",
        "symfony/css-selector": ">=7.4.9",
        "symfony/doctrine-messenger": ">=7.4.6",
        "symfony/dotenv": ">=7.4.11",
        "symfony/expression-language": ">=7.4.8",
        "symfony/filesystem": ">=7.4.11",
        "symfony/finder": ">=7.4.8",
        "symfony/flex": "^2.11",
        "symfony/form": ">=7.4.9",
        "symfony/framework-bundle": ">=7.4.13",
        "symfony/http-client": ">=7.4.13",
        "symfony/intl": ">=7.4.8",
        "symfony/mailer": ">=7.4.12",
        "symfony/messenger": ">=7.4.12",
        "symfony/mime": ">=7.4.13",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/notifier": ">=7.4.8",
        "symfony/phpunit-bridge": "^7.4.8",
        "symfony/process": ">=7.4.13",
        "symfony/property-access": ">=7.4.8",
        "symfony/property-info": ">=7.4.8",
        "symfony/runtime": ">=7.4.13",
        "symfony/security-bundle": ">=7.4.13",
        "symfony/serializer": ">=7.4.10",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": ">=7.4.13",
        "symfony/translation": ">=7.4.10",
        "symfony/twig-bundle": ">=7.4.8",
        "symfony/uid": ">=7.4.9",
        "symfony/ux-turbo": "^2.36",
        "symfony/validator": ">=7.4.10",
        "symfony/web-link": ">=7.4.8",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": ">=7.4.13",
        "twig/extra-bundle": "^2.12|^3.24",
        "twig/twig": "^2.12|^3.27.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "src/"
            ],
            "App\\Domain\\API\\": "api",
            "DoctrineMigrations\\": "migrations/src/",
            "ServerManager\\": "ServerManager/classes/",
            "App\\Tests\\": "tests/",
            "App\\DataFixtures\\": "fixtures/"
        },
        "files": [
            "src/helpers.php",
            "src/functions.php",
            "src/Domain/WsServer/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
	        "App\\DataFixtures\\": "fixtures/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "(php -d memory_limit=1G bin/console doctrine:cache:clear-metadata -n || true)",
            "@auto-scripts",
            "bash tools/cghooks-fresh-install.sh"
        ],
        "post-update-cmd": [
            "(php -d memory_limit=1G bin/console doctrine:cache:clear-metadata -n || true)",
            "@auto-scripts",
            "bash tools/cghooks-fresh-install.sh"
        ],
        "cghooks": "vendor/bin/cghooks"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "hooks": {
            "config": {
                "stop-on-failure": ["pre-push"]
            },
            "post-merge": [
                "bash install.sh"
            ],
            "pre-push": [
                "bash test.sh",
                "vendor/bin/phpstan analyse --memory-limit=1G"
            ]
        },
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "brainmaestro/composer-git-hooks": "dev-master",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "jetbrains/phpstorm-attributes": "^1.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-doctrine": "^2.0.27",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^9.6.34",
        "squizlabs/php_codesniffer": "^3.13.5",
        "symfony/browser-kit": ">=7.4.8",
        "symfony/css-selector": ">=7.4.9",
        "symfony/debug-bundle": ">=7.4.8",
        "symfony/maker-bundle": "^1.67",
        "symfony/phpunit-bridge": "^7.4.8",
        "symfony/stopwatch": ">=7.4.8",
        "symfony/web-profiler-bundle": ">=7.4.13"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BredaUniversityResearch/composer-git-hooks.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/BredaUniversityResearch/Ratchet.git"
        }
    ]
}
